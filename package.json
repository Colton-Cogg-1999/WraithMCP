{
  "name": "wraith",
  "version": "0.1.0",
  "description": "Wraith: deterministic MCP server and CLI that turns your coding agent into a context-aware localization engineer (visual QA, tiered QE, TMS round-trip).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "polyglot": "./dist/bin.js",
    "wraith": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills",
    "docs"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:sea": "node scripts/build-sea.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/bin.ts",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@formatjs/icu-messageformat-parser": "^2.9.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@vue/compiler-sfc": "^3.5.0",
    "commander": "^13.1.0",
    "fflate": "^0.8.2",
    "svelte": "^5.20.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
