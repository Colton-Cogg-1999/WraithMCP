      "segments": {
        "source": [
          {
            "id": "document-p1",
            "text": "Northstar Billing and Data Retention Policy"
          },
          {
            "id": "document-p2",
            "text": "This policy explains how Northstar processes subscription payments through Northstar Pay and archives compliance records in LedgerVault."
          },
          {
            "id": "document-p3",
            "text": "1. Subscription Invoices and Grace Periods"
          },
          {
            "id": "document-p4",
            "text": "Every Workspace receives an itemized monthly Invoice on the first business day of the billing cycle."
          },
          {
            "id": "document-p5",
            "text": "If a payment fails, we retry automatically for fourteen calendar days before pausing non-essential analytics exports."
          },
          {
            "id": "document-p6",
            "text": "Review full tax documentation on the Northstar Help Center before submitting an exemption certificate."
          },
          {
            "id": "document-p7",
            "text": "2. Service Tiers and Retention Schedule"
          },
          {
            "id": "document-p8",
            "text": "Plan Tier"
          },
          {
            "id": "document-p9",
            "text": "Audit Log Retention"
          },
          {
            "id": "document-p10",
            "text": "Support Response Target"
          },
          {
            "id": "document-p11",
            "text": "Starter Workspace"
          },
          {
            "id": "document-p12",
            "text": "Ninety days of searchable activity"
          },
          {
            "id": "document-p13",
            "text": "Two business days via email"
          },
          {
            "id": "document-p14",
            "text": "Enterprise Workspace"
          },
          {
            "id": "document-p15",
            "text": "Seven years in LedgerVault"
          },
          {
            "id": "document-p16",
            "text": "Four hours with priority escalation"
          },
          {
            "id": "document-p17",
            "text": "3. Approved Legal Revisions"
          },
          {
            "id": "document-p18",
            "text": "The compliance committee formally approved quarterly deletion audits for inactive merchant accounts."
          },
          {
            "id": "document-p19",
            "text": "Account owners may request immediate deletion of archived exports after settling every open Invoice."
          },
          {
            "id": "document-p20",
            "text": "Security notifications are delivered to the primary administrator and recorded in PulseGrid."
          },
          {
            "id": "comments-p21",
            "text": "Confirm whether annual invoices follow the same first-business-day schedule."
          },
          {
            "id": "footer1-p22",
            "text": "Confidential policy summary — Page"
          },
          {
            "id": "footnotes-p23",
            "text": "Grace period reminders are sent automatically on day three, day seven, and day twelve."
          },
          {
            "id": "header1-p24",
            "text": "Northstar Commerce — Customer Billing Policy"
          }
        ],
        "wraith": [
          {
            "id": "document-p1",
            "text": "Northstar-Richtlinie zur Abrechnung und Datenaufbewahrung"
          },
          {
            "id": "document-p2",
            "text": "Diese Richtlinie erläutert, wie Northstar Abonnementzahlungen über Northstar Pay abwickelt und Compliance-Nachweise in LedgerVault archiviert."
          },
          {
            "id": "document-p3",
            "text": "1. Rechnungen für Abonnements und Zahlungsnachfristen"
          },
          {
            "id": "document-p4",
            "text": "Jeder Arbeitsbereich erhält am ersten Geschäftstag jedes Abrechnungszeitraums eine monatliche Rechnung mit allen Einzelposten."
          },
          {
            "id": "document-p5",
            "text": "Schlägt eine Zahlung fehl, versuchen wir vierzehn Kalendertage lang automatisch erneut, den Betrag einzuziehen, bevor wir nicht zwingend erforderliche Exporte von Analysedaten vorübergehend aussetzen."
          },
          {
            "id": "document-p6",
            "text": "Lesen Sie die vollständigen Steuerunterlagen im Northstar-Hilfezentrum, bevor Sie eine Bescheinigung über die Steuerbefreiung einreichen."
          },
          {
            "id": "document-p7",
            "text": "2. Tarifstufen und Aufbewahrungsfristen"
          },
          {
            "id": "document-p8",
            "text": "Tarifstufe"
          },
          {
            "id": "document-p9",
            "text": "Aufbewahrungsfrist für Auditprotokolle"
          },
          {
            "id": "document-p10",
            "text": "Angestrebte Antwortzeit des Supports"
          },
          {
            "id": "document-p11",
            "text": "Starter-Arbeitsbereich"
          },
          {
            "id": "document-p12",
            "text": "Aktivitäten der letzten 90 Tage durchsuchbar"
          },
          {
            "id": "document-p13",
            "text": "Zwei Geschäftstage per E-Mail"
          },
          {
            "id": "document-p14",
            "text": "Enterprise-Arbeitsbereich"
          },
          {
            "id": "document-p15",
            "text": "Sieben Jahre in LedgerVault"
          },
          {
            "id": "document-p16",
            "text": "Vier Stunden bei vorrangiger Eskalation"
          },
          {
            "id": "document-p17",
            "text": "3. Genehmigte Änderungen an den rechtlichen Bestimmungen"
          },
          {
            "id": "document-p18",
            "text": "Der Compliance-Ausschuss hat vierteljährliche Prüfungen der Datenlöschung bei inaktiven Händlerkonten förmlich genehmigt."
          },
          {
            "id": "document-p19",
            "text": "Kontoinhaber können die sofortige Löschung archivierter Exporte beantragen, sobald sie alle offenen Rechnungen beglichen haben."
          },
          {
            "id": "document-p20",
            "text": "Der Hauptadministrator erhält Sicherheitsbenachrichtigungen. Diese werden in PulseGrid protokolliert."
          },
          {
            "id": "comments-p21",
            "text": "Bitte bestätigen Sie, ob auch Jahresrechnungen am ersten Geschäftstag des Abrechnungszeitraums ausgestellt werden."
          },
          {
            "id": "footer1-p22",
            "text": "Vertrauliche Zusammenfassung der Richtlinie – Seite"
          },
          {
            "id": "footnotes-p23",
            "text": "Am dritten, siebten und zwölften Tag der Zahlungsnachfrist werden automatisch Erinnerungen versandt."
          },
          {
            "id": "header1-p24",
            "text": "Northstar Commerce – Richtlinie zur Kundenabrechnung"
          }
        ],
        "deepl": []
      }
    },
